# ── 필수 ──
APP_ENV=development                 # production(Render) | development(내 컴퓨터) | test
APP_BASE_URL=http://localhost:5000  # 배포 주소. 예: https://ai-mom-studio.onrender.com
APP_DATABASE_URL=                   # Neon 연결 주소(postgresql://...?sslmode=require). 없으면 DATABASE_URL을 사용
APP_SESSION_SECRET=                 # 32자 이상 임의 문자열
ADMIN_USERNAME=                     # 운영자 아이디(이 아이디만 운영자로 허용)
ADMIN_PASSWORD_HASH=                # npm run hash-password -- "비밀번호" 결과값

# ── 수집·생성 ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
AI_PROVIDER=auto                  # auto(GPT 우선) | openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── 이미지·게시 ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=            # 개인 검토 알림을 받을 내 채팅 ID(공개 채널과 별도)
INSTAGRAM_API_VERSION=              # 공식 문서에서 확인한 버전(예: vNN.0)
# 목적지별(채널 slug별) — 채널 설정 화면의 '참조 환경변수' 이름과 같게
# TG_OPPORTUNITIES_CHAT_ID=@my_channel
# IG_OPPORTUNITIES_ACCESS_TOKEN=
# IG_OPPORTUNITIES_USER_ID=

# ── 안전 스위치(기본값) ──
DEMO_MODE=false
DRY_RUN=true
AUTO_COLLECT=false
AUTO_GENERATE=false
AUTO_PUBLISH=false

